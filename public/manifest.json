{
  "manifest_version": 3,
  "name": "Tabsy",
  "version": "1.4.0",
  "description": "Your tabs. Your worlds. Zero chaos.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "contextMenus",
    "identity"
  ],
  "commands": {
    "open-tabsy": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Open Tabsy"
    },
    "save-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current tabs to Tabsy"
    }
  },
  "action": {},
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "122605702874-5850rsqmmo7thfng8lephn9cb8lo0mvk.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
